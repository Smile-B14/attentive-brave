{
  "manifest_version": 3,
  "name": "Attentive Brave",
  "description": "Adds the mandatory sight-pump overlay for Attentive Brave testing.",
  "version": "0.3.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["attentive.js"],
      "run_at": "document_start"
    }
  ]
}
